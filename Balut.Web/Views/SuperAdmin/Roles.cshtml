@{
    ViewData["Title"] = "مدیریت نقش‌ها";
}

<h4 class="fw-bold mb-4"> مدیریت نقش‌ها</h4>

<div class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <label class="form-label">نام نقش جدید</label>
            <input type="text" id="newRoleName" class="form-control" placeholder="مثلاً: Accountant" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100" onclick="createRole()">+ ساخت نقش</button>
        </div>
    </div>
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>نام نقش</th><th>تعداد کاربران</th></tr>
            </thead>
            <tbody id="tableBody"><tr><td colspan="3" class="text-center py-4">در حال بارگذاری...</td></tr></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', loadRoles);

        async function loadRoles() {
            try {
                const roles = await ajaxGet('/SuperAdmin/GetRoles');
                document.getElementById('tableBody').innerHTML = roles.map((r, i) => `
                        <tr>
                            <td>${i + 1}</td>
                            <td><span class="badge bg-info">${escapeHtml(r.name)}</span></td>
                            <td>${r.userCount} کاربر</td>
                        </tr>`).join('');
            } catch (e) { showToast('خطا در دریافت نقش‌ها', false); }
        }

        async function createRole() {
            const name = document.getElementById('newRoleName').value.trim();
            if (!name) { showToast('نام نقش الزامی است.', false); return; }
            try {
                const res = await ajaxPost('/SuperAdmin/CreateRole', { roleName: name });
                showToast(res.message, res.success);
                if (res.success) { document.getElementById('newRoleName').value = ''; loadRoles(); }
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}