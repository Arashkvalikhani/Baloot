@{
    ViewData["Title"] = "مدیریت والدین";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">مدیریت والدین</h4>
    <button class="btn btn-primary" onclick="openCreateModal()">+ افزودن والد</button>
</div>

<div class="card stat-card p-3 mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="جستجو بر اساس نام یا کد ملی..." />
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>نام</th><th>نام خانوادگی</th><th>کد ملی</th><th>شغل</th><th>تلفن</th><th>وضعیت</th><th>عملیات</th></tr>
            </thead>
            <tbody id="tableBody"><tr><td colspan="8" class="text-center py-4">در حال بارگذاری...</td></tr></tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center bg-white">
        <span id="pageInfo" class="small text-muted"></span>
        <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
    </div>
</div>

<!-- مودال فرم والد -->
<div class="modal fade" id="parentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">افزودن والد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="parentId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">نام *</label><input type="text" id="firstName" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">نام خانوادگی *</label><input type="text" id="lastName" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">کد ملی *</label><input type="text" id="nationalCode" class="form-control" maxlength="10" /></div>
                    <div class="col-md-6"><label class="form-label">تلفن</label><input type="text" id="phoneNumber" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">شغل</label><input type="text" id="occupation" class="form-control" /></div>
                    <div class="col-md-6">
                        <label class="form-label">وضعیت</label>
                        <select id="status" class="form-select"><option value="1">فعال</option><option value="0">غیرفعال</option></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-success" onclick="saveParent()"> ذخیره</button>
            </div>
        </div>
    </div>
</div>

<!-- مودال مدیریت فرزندان -->
<div class="modal fade" id="childrenModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">‍‍👧 فرزندان: <span id="childrenParentName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="childrenParentId" value="0" />
                <div id="childrenList" class="mb-3"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label">افزودن فرزند (دانشجو)</label>
                        <select id="studentSelect" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100" onclick="addChild()">+ اتصال</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let parentModal, childrenModal;

        document.addEventListener('DOMContentLoaded', () => {
            parentModal = new bootstrap.Modal(document.getElementById('parentModal'));
            childrenModal = new bootstrap.Modal(document.getElementById('childrenModal'));
            loadParents(1);
            let timer;
            document.getElementById('searchInput').addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => loadParents(1), 400);
            });
        });

        async function loadParents(page) {
            currentPage = page;
            const search = document.getElementById('searchInput').value.trim();
            try {
                const res = await ajaxGet(`/Parent/GetParents?pageNumber=${page}&pageSize=10&search=${encodeURIComponent(search)}`);
                renderTable(res);
                renderPagination(res);
            } catch (e) { showToast('خطا در دریافت اطلاعات', false); }
        }

        function renderTable(res) {
            const tbody = document.getElementById('tableBody');
            if (!res.items || res.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">هیچ والدی یافت نشد.</td></tr>';
                document.getElementById('pageInfo').textContent = '';
                return;
            }
            tbody.innerHTML = res.items.map((p, i) => `
                <tr>
                    <td>${(res.pageNumber - 1) * res.pageSize + i + 1}</td>
                    <td>${escapeHtml(p.firstName)}</td>
                    <td>${escapeHtml(p.lastName)}</td>
                    <td>${escapeHtml(p.nationalCode)}</td>
                    <td>${escapeHtml(p.occupation) || '-'}</td>
                    <td>${p.phoneNumber ? escapeHtml(p.phoneNumber) : '-'}</td>
                    <td>${p.status === 1 ? '<span class="badge bg-success">فعال</span>' : '<span class="badge bg-danger">غیرفعال</span>'}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-success" onclick="openChildrenModal(${p.id})">👧 فرزندان</button>
                        <button class="btn btn-sm btn-outline-primary" onclick="openEditModal(${p.id})"></button>
                        <button class="btn btn-sm btn-outline-warning" onclick="toggleStatus(${p.id})">${p.status === 1 ? '' : ''}</button>
                    </td>
                </tr>`).join('');
            document.getElementById('pageInfo').textContent = `صفحه ${res.pageNumber} از ${res.totalPages} - مجموع ${res.totalCount} والد`;
        }

        function renderPagination(res) {
            const ul = document.getElementById('pagination');
            ul.innerHTML = '';
            for (let p = 1; p <= res.totalPages; p++) {
                const li = document.createElement('li');
                li.className = 'page-item' + (p === res.pageNumber ? ' active' : '');
                li.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="loadParents(${p})">${p}</a>`;
                ul.appendChild(li);
            }
        }

        function openCreateModal() {
            document.getElementById('modalTitle').textContent = 'افزودن والد';
            ['parentId', 'firstName', 'lastName', 'nationalCode', 'phoneNumber', 'occupation'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('parentId').value = 0;
            document.getElementById('status').value = '1';
            parentModal.show();
        }

        async function openEditModal(id) {
            try {
                const p = await ajaxGet('/Parent/GetDetail?id=' + id);
                document.getElementById('modalTitle').textContent = 'ویرایش والد';
                document.getElementById('parentId').value = p.id;
                document.getElementById('firstName').value = p.firstName || '';
                document.getElementById('lastName').value = p.lastName || '';
                document.getElementById('nationalCode').value = p.nationalCode || '';
                document.getElementById('phoneNumber').value = p.phoneNumber || '';
                document.getElementById('occupation').value = p.occupation || '';
                document.getElementById('status').value = p.status.toString();
                parentModal.show();
            } catch (e) { showToast('خطا در دریافت اطلاعات', false); }
        }

        async function saveParent() {
            const id = parseInt(document.getElementById('parentId').value);
            const data = {
                id: id,
                firstName: document.getElementById('firstName').value.trim(),
                lastName: document.getElementById('lastName').value.trim(),
                nationalCode: document.getElementById('nationalCode').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                occupation: document.getElementById('occupation').value.trim(),
                status: parseInt(document.getElementById('status').value)
            };

            if (!data.firstName || !data.lastName || !data.nationalCode) { showToast('نام، نام خانوادگی و کد ملی الزامی هستند.', false); return; }
            if (!/^\d{10}$/.test(data.nationalCode)) { showToast('کد ملی باید 10 رقم باشد.', false); return; }

            try {
                const res = await ajaxPost(id === 0 ? '/Parent/Create' : '/Parent/Update', data);
                showToast(res.message, res.success);
                if (res.success) { parentModal.hide(); loadParents(currentPage); }
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        async function toggleStatus(id) {
            try {
                const res = await ajaxPost('/Parent/ToggleStatus', { id });
                showToast(res.message, res.success);
                if (res.success) loadParents(currentPage);
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        // ===== مدیریت فرزندان =====
        async function openChildrenModal(id) {
            document.getElementById('childrenParentId').value = id;
            await loadChildren();
            await loadStudentsForSelect();
            childrenModal.show();
        }

        async function loadChildren() {
            const id = parseInt(document.getElementById('childrenParentId').value);
            try {
                const p = await ajaxGet('/Parent/GetDetail?id=' + id);
                document.getElementById('childrenParentName').textContent = `${p.firstName} ${p.lastName}`;

                document.getElementById('childrenList').innerHTML = p.children.length === 0
                    ? '<div class="alert alert-light border small">هنوز فرزندی متصل نشده است.</div>'
                    : p.children.map(c => `
                        <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
                            <span>🧑‍ <b>${escapeHtml(c.fullName)}</b> <span class="text-muted small">(${escapeHtml(c.nationalCode) || '-'})</span></span>
                            <button class="btn btn-sm btn-outline-danger" onclick="removeChild(${c.studentId})">حذف اتصال</button>
                        </div>`).join('');
            } catch (e) { showToast('خطا در دریافت اطلاعات', false); }
        }

        async function loadStudentsForSelect() {
            const students = await ajaxGet('/Student/GetAll');
            document.getElementById('studentSelect').innerHTML =
                students.map(s => `<option value="${s.id}">${escapeHtml(s.firstName)} ${escapeHtml(s.lastName)} (${escapeHtml(s.nationalCode)})</option>`).join('');
        }

        async function addChild() {
            const parentId = parseInt(document.getElementById('childrenParentId').value);
            const studentId = parseInt(document.getElementById('studentSelect').value);
            try {
                const res = await ajaxPost('/Parent/AddChild', { parentId, studentId });
                showToast(res.message, res.success);
                if (res.success) loadChildren();
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        async function removeChild(studentId) {
            if (!confirm('اتصال این فرزند حذف شود؟')) return;
            const parentId = parseInt(document.getElementById('childrenParentId').value);
            try {
                const res = await ajaxPost('/Parent/RemoveChild', { parentId, studentId });
                showToast(res.message, res.success);
                if (res.success) loadChildren();
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}