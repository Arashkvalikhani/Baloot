@{
    ViewData["Title"] = "دانشجویان کلاس";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">دانشجویان کلاس: <span id="className"></span></h4>
    <a href="/TeacherPanel/Index" class="btn btn-outline-secondary btn-sm">بازگشت به پنل</a>
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>دانشجو</th>
                    <th>دوره</th>
                    <th>تاریخ ثبت‌نام</th>
                    <th>وضعیت</th>
                    <th>پرداخت</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="6" class="text-center py-4">در حال بارگذاری...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <span id="countInfo" class="small text-muted"></span>
    </div>
</div>

@section Scripts {
    <script>
        const classId = @ViewData["ClassId"];

        document.addEventListener('DOMContentLoaded', () => {
            loadClassName();
            loadStudents();
        });

        async function loadClassName() {
            try {
                const c = await ajaxGet('/Class/GetById?id=' + classId);
                document.getElementById('className').textContent = c.name;
            } catch (e) { }
        }

        async function loadStudents() {
            try {
                const items = await ajaxGet('/TeacherPanel/GetClassStudents?classId=' + classId);
                const tbody = document.getElementById('tableBody');

                if (!items || items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">هنوز دانشجویی در این کلاس ثبت‌نام نکرده است.</td></tr>';
                    document.getElementById('countInfo').textContent = '';
                    return;
                }

                tbody.innerHTML = items.map((e, i) => `
                        <tr>
                            <td>${i + 1}</td>
                            <td><b>${escapeHtml(e.studentName)}</b></td>
                            <td>${escapeHtml(e.courseTitle)}</td>
                            <td>${new Date(e.enrollmentDate).toLocaleDateString('fa-IR')}</td>
                            <td>${e.status === 1 ? '<span class="badge bg-success">فعال</span>' : '<span class="badge bg-secondary">انصراف</span>'}</td>
                            <td>${e.paymentStatus === 1 ? '<span class="badge bg-success">پرداخت شده</span>' : '<span class="badge bg-warning">پرداخت نشده</span>'}</td>
                        </tr>`).join('');

                const active = items.filter(x => x.status === 1).length;
                document.getElementById('countInfo').textContent =
                    `مجموع ${items.length} ثبت‌نام | ${active} دانشجوی فعال`;
            } catch (e) {
                showToast('خطا در دریافت دانشجویان کلاس', false);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}