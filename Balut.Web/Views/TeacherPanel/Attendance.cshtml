@{
    ViewData["Title"] = "ثبت حضور و غیاب";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">ثبت حضور و غیاب جلسه</h4>
    <button class="btn btn-success" onclick="saveAttendance()"> ذخیره حضور و غیاب</button>
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>دانشجو</th><th>وضعیت</th><th>دقیقه تأخیر</th></tr>
            </thead>
            <tbody id="tableBody"><tr><td colspan="4" class="text-center py-4">در حال بارگذاری...</td></tr></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const sessionId = @ViewData["SessionId"];

        document.addEventListener('DOMContentLoaded', loadAttendance);

        async function loadAttendance() {
            try {
                const items = await ajaxGet('/TeacherPanel/GetAttendanceData?sessionId=' + sessionId);
                const tbody = document.getElementById('tableBody');

                if (!items || items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">هیچ دانشجویی در این کلاس ثبت‌نام نکرده است.</td></tr>';
                    return;
                }

                tbody.innerHTML = items.map((a, i) => `
                        <tr data-student="${a.studentId}">
                            <td>${i + 1}</td>
                            <td>${escapeHtml(a.studentName)}</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <input type="radio" class="btn-check" name="status_${a.studentId}" id="p_${a.studentId}" value="1" ${a.status === 1 ? 'checked' : ''}>
                                    <label class="btn btn-outline-success btn-sm" for="p_${a.studentId}">حاضر</label>
                                    <input type="radio" class="btn-check" name="status_${a.studentId}" id="a_${a.studentId}" value="2" ${a.status === 2 ? 'checked' : ''}>
                                    <label class="btn btn-outline-danger btn-sm" for="a_${a.studentId}">غایب</label>
                                    <input type="radio" class="btn-check" name="status_${a.studentId}" id="l_${a.studentId}" value="3" ${a.status === 3 ? 'checked' : ''}>
                                    <label class="btn btn-outline-warning btn-sm" for="l_${a.studentId}">تأخیر</label>
                                </div>
                            </td>
                            <td style="width:150px">
                                <input type="number" class="form-control form-control-sm late-input" min="1" max="120"
                                       value="${a.lateMinutes || ''}" placeholder="دقیقه" ${a.status === 3 ? '' : 'disabled'} />
                            </td>
                        </tr>`).join('');

                // فعال/غیرفعال کردن input تأخیر بر اساس انتخاب
                tbody.addEventListener('change', (e) => {
                    if (e.target.type === 'radio') {
                        const row = e.target.closest('tr');
                        const lateInput = row.querySelector('.late-input');
                        lateInput.disabled = e.target.value !== '3';
                        if (e.target.value !== '3') lateInput.value = '';
                    }
                });
            } catch (e) { showToast('خطا در دریافت اطلاعات', false); }
        }

        async function saveAttendance() {
            const rows = document.querySelectorAll('#tableBody tr[data-student]');
            const items = [];

            rows.forEach(row => {
                const studentId = parseInt(row.getAttribute('data-student'));
                const checked = row.querySelector(`input[name="status_${studentId}"]:checked`);
                const status = checked ? parseInt(checked.value) : 1;
                const lateVal = row.querySelector('.late-input').value;

                items.push({
                    studentId: studentId,
                    studentName: '',
                    status: status,
                    lateMinutes: status === 3 && lateVal ? parseInt(lateVal) : null
                });
            });

            try {
                const res = await ajaxPost('/TeacherPanel/SaveAttendance', { sessionId: sessionId, items: items });
                showToast(res.message, res.success);
            } catch (e) { showToast('خطا در ارتباط با سرور', false); }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}