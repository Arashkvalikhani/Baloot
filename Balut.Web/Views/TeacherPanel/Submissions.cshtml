@{
    ViewData["Title"] = "ارسال‌های تمرین";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"> ارسال‌های دانشجویان</h4>
    <button class="btn btn-outline-secondary btn-sm" onclick="history.back()">بازگشت</button>
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>دانشجو</th>
                    <th>متن پاسخ</th>
                    <th>پیوست</th>
                    <th>تاریخ ارسال</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="7" class="text-center py-4">در حال بارگذاری...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <span id="countInfo" class="small text-muted"></span>
    </div>
</div>

<!-- مودال نمره‌دهی -->
<div class="modal fade" id="gradeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> نمره‌دهی و بررسی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="gradeSubmissionId" value="0" />
                <div id="gradeInfo" class="alert alert-light border small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">نمره (0 تا 10)</label>
                    <input type="number" id="gradeScore" class="form-control" min="0" max="10" step="0.25" />
                </div>
                <div class="mb-3">
                    <label class="form-label">نظر معلم</label>
                    <textarea id="gradeComment" class="form-control" rows="3" placeholder="بازخورد برای دانشجو..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-success" onclick="saveGrade()"> ثبت نمره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const exerciseId = @ViewData["ExerciseId"];
        let submissions = [];
        let gradeModalInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            gradeModalInstance = new bootstrap.Modal(document.getElementById('gradeModal'));
            loadSubmissions();
        });

        async function loadSubmissions() {
            try {
                submissions = await ajaxGet('/TeacherPanel/GetSubmissions?exerciseId=' + exerciseId);
                const tbody = document.getElementById('tableBody');

                if (!submissions || submissions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">هنوز ارسالی ثبت نشده است.</td></tr>';
                    document.getElementById('countInfo').textContent = '';
                    return;
                }

                tbody.innerHTML = submissions.map((s, i) => `
                        <tr>
                            <td>${i + 1}</td>
                            <td><b>${escapeHtml(s.studentName)}</b></td>
                            <td style="max-width:250px"><div class="small">${escapeHtml(s.textContent) || '-'}</div></td>
                            <td>${s.attachmentId
                        ? `<a href="/File/Download/${s.attachmentId}" class="btn btn-sm btn-outline-secondary">📎 ${escapeHtml(s.attachmentName)}</a>`
                        : '-'}</td>
                            <td class="small">${new Date(s.submittedAt).toLocaleString('fa-IR')}</td>
                            <td>${s.status === 2
                        ? `<span class="badge bg-success">بررسی شده - نمره ${s.score}</span>`
                        : '<span class="badge bg-warning">در انتظار بررسی</span>'}</td>
                            <td>
                                <button class="btn btn-sm btn-primary" onclick="openGradeModal(${s.id})"> نمره‌دهی</button>
                            </td>
                        </tr>`).join('');

                const graded = submissions.filter(s => s.status === 2).length;
                document.getElementById('countInfo').textContent =
                    `مجموع ${submissions.length} ارسال | ${graded} بررسی شده | ${submissions.length - graded} در انتظار`;
            } catch (e) {
                showToast('خطا در دریافت ارسال‌ها', false);
            }
        }

        function openGradeModal(id) {
            const s = submissions.find(x => x.id === id);
            if (!s) return;

            document.getElementById('gradeSubmissionId').value = s.id;
            document.getElementById('gradeInfo').innerHTML =
                `<b>${escapeHtml(s.studentName)}</b> | ارسال: ${new Date(s.submittedAt).toLocaleString('fa-IR')}`;
            document.getElementById('gradeScore').value = s.score !== null ? s.score : '';
            document.getElementById('gradeComment').value = s.teacherComment || '';
            gradeModalInstance.show();
        }

        async function saveGrade() {
            const scoreVal = document.getElementById('gradeScore').value;
            const score = scoreVal !== '' ? parseFloat(scoreVal) : null;

            if (score !== null && (isNaN(score) || score < 0 || score > 10)) {
                showToast('نمره باید عددی بین 0 تا 10 باشد.', false);
                return;
            }

            const data = {
                submissionId: parseInt(document.getElementById('gradeSubmissionId').value),
                score: score,
                comment: document.getElementById('gradeComment').value.trim() || null
            };

            try {
                const res = await ajaxPost('/TeacherPanel/GradeSubmission', data);
                showToast(res.message, res.success);
                if (res.success) {
                    gradeModalInstance.hide();
                    loadSubmissions();
                }
            } catch (e) {
                showToast('خطا در ارتباط با سرور', false);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}