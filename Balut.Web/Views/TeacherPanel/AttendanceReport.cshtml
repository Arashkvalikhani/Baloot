@{
    ViewData["Title"] = "لیست حضور و غیاب";
}

<h4 class="fw-bold mb-4"> لیست حضور و غیاب</h4>

<div class="card stat-card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <label class="form-label">کلاس</label>
            <select id="classFilter" class="form-select">
                <option value="">همه کلاس‌ها</option>
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label">جلسه</label>
            <select id="sessionFilter" class="form-select">
                <option value="">همه جلسات</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-secondary w-100" onclick="loadReport()"> بروزرسانی</button>
        </div>
    </div>
</div>

<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>دانشجو</th>
                    <th>کلاس</th>
                    <th>جلسه</th>
                    <th>تاریخ</th>
                    <th>وضعیت</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="6" class="text-center py-4">در حال بارگذاری...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <span id="countInfo" class="small text-muted"></span>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            await loadClassFilter();
            await loadReport();

            document.getElementById('classFilter').addEventListener('change', async (e) => {
                await loadSessionFilter(e.target.value);
                await loadReport();
            });

            document.getElementById('sessionFilter').addEventListener('change', () => loadReport());
        });

        async function loadClassFilter() {
            const classes = await ajaxGet('/TeacherPanel/GetMyClasses');
            document.getElementById('classFilter').innerHTML =
                '<option value="">همه کلاس‌ها</option>' +
                classes.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('');
        }

        async function loadSessionFilter(classId) {
            const sessionSelect = document.getElementById('sessionFilter');
            if (!classId) {
                sessionSelect.innerHTML = '<option value="">همه جلسات</option>';
                return;
            }
            const sessions = await ajaxGet('/TeacherPanel/GetSessions?classId=' + classId);
            sessionSelect.innerHTML = '<option value="">همه جلسات</option>' +
                sessions.map(s => `<option value="${s.id}">جلسه ${s.sessionNumber}</option>`).join('');
        }

        async function loadReport() {
            const classId = document.getElementById('classFilter').value;
            const sessionId = document.getElementById('sessionFilter').value;

            const qs = new URLSearchParams();
            if (classId) qs.append('classId', classId);
            if (sessionId) qs.append('sessionId', sessionId);

            try {
                const items = await ajaxGet('/TeacherPanel/GetAttendanceReport?' + qs.toString());
                const tbody = document.getElementById('tableBody');

                if (!items || items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">هیچ رکورد حضور و غیابی یافت نشد.</td></tr>';
                    document.getElementById('countInfo').textContent = '';
                    return;
                }

                tbody.innerHTML = items.map((a, i) => {
                    let statusBadge = '';
                    if (a.status === 1) statusBadge = '<span class="badge bg-success">حاضر</span>';
                    else if (a.status === 2) statusBadge = '<span class="badge bg-danger">غایب</span>';
                    else statusBadge = `<span class="badge bg-warning">تأخیر ${a.lateMinutes || 0} دقیقه</span>`;

                    return `
                        <tr>
                            <td>${i + 1}</td>
                            <td><b>${escapeHtml(a.studentName)}</b></td>
                            <td>${escapeHtml(a.className)}</td>
                            <td>جلسه ${a.sessionNumber}</td>
                            <td>${new Date(a.date).toLocaleDateString('fa-IR')}</td>
                            <td>${statusBadge}</td>
                        </tr>`;
                }).join('');

                const present = items.filter(x => x.status === 1).length;
                const absent = items.filter(x => x.status === 2).length;
                const late = items.filter(x => x.status === 3).length;
                document.getElementById('countInfo').textContent =
                    `مجموع ${items.length} رکورد | حاضر: ${present} | غایب: ${absent} | تأخیر: ${late}`;
            } catch (e) {
                showToast('خطا در دریافت گزارش حضور و غیاب', false);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}