@{
    ViewData["Title"] = "مدیریت دانشجویان";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">مدیریت دانشجویان</h4>
    <button class="btn btn-primary" onclick="openCreateModal()">+ افزودن دانشجو</button>
</div>

<!-- جستجو و فیلتر -->
<div class="card stat-card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" id="searchInput" class="form-control"
                   placeholder="جستجو بر اساس نام، نام خانوادگی یا کد ملی..." />
        </div>
        <div class="col-md-3">
            <select id="statusFilter" class="form-select">
                <option value="">همه وضعیت‌ها</option>
                <option value="1">فعال</option>
                <option value="0">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-secondary w-100" onclick="loadStudents(1)"> بروزرسانی</button>
        </div>
    </div>
</div>

<!-- جدول -->
<div class="card stat-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>نام</th>
                    <th>نام خانوادگی</th>
                    <th>کد ملی</th>
                    <th>تلفن</th>
                    <th>وضعیت</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody id="studentsTableBody">
                <tr><td colspan="7" class="text-center py-4">در حال بارگذاری...</td></tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center bg-white">
        <span id="pageInfo" class="small text-muted"></span>
        <nav>
            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
        </nav>
    </div>
</div>

<!-- مودال افزودن / ویرایش -->
<div class="modal fade" id="studentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">افزودن دانشجو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="studentId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">نام *</label>
                        <input type="text" id="firstName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نام خانوادگی *</label>
                        <input type="text" id="lastName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">کد ملی *</label>
                        <input type="text" id="nationalCode" class="form-control" maxlength="10" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">شماره تلفن</label>
                        <input type="text" id="phoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">تاریخ تولد</label>
                        <input type="date" id="dateOfBirth" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">وضعیت</label>
                        <select id="status" class="form-select">
                            <option value="1">فعال</option>
                            <option value="0">غیرفعال</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">آدرس</label>
                        <textarea id="address" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-success" onclick="saveStudent()"> ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let modalInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            modalInstance = new bootstrap.Modal(document.getElementById('studentModal'));
            loadStudents(1);

            // جستجوی زنده با تأخیر (Debounce)
            let timer;
            document.getElementById('searchInput').addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => loadStudents(1), 400);
            });

            document.getElementById('statusFilter').addEventListener('change', () => loadStudents(1));
        });

        // ===== دریافت و نمایش لیست =====
        async function loadStudents(page) {
            currentPage = page;
            const search = document.getElementById('searchInput').value.trim();
            const status = document.getElementById('statusFilter').value;

            const qs = new URLSearchParams();
            qs.append('PageNumber', page);
            qs.append('PageSize', 10);
            if (search) qs.append('Search', search);
            if (status !== '') qs.append('Status', status);

            try {
                const res = await ajaxGet('/Student/GetStudents?' + qs.toString());
                renderTable(res);
                renderPagination(res);
            } catch (e) {
                showToast('خطا در دریافت اطلاعات از سرور', false);
            }
        }

        function renderTable(res) {
            const tbody = document.getElementById('studentsTableBody');

            if (!res.items || res.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">هیچ دانشجویی یافت نشد.</td></tr>';
                document.getElementById('pageInfo').textContent = '';
                return;
            }

            tbody.innerHTML = res.items.map((s, i) => `
                    <tr>
                        <td>${(res.pageNumber - 1) * res.pageSize + i + 1}</td>
                        <td>${escapeHtml(s.firstName)}</td>
                        <td>${escapeHtml(s.lastName)}</td>
                        <td>${escapeHtml(s.nationalCode)}</td>
                        <td>${s.phoneNumber ? escapeHtml(s.phoneNumber) : '-'}</td>
                        <td>${s.status === 1
                    ? '<span class="badge bg-success">فعال</span>'
                    : '<span class="badge bg-danger">غیرفعال</span>'}</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary mb-1" onclick="openEditModal(${s.id})"> ویرایش</button>
                            <button class="btn btn-sm btn-outline-warning mb-1" onclick="toggleStatus(${s.id})">${s.status === 1 ? ' غیرفعال' : ' فعال'}</button>
                            <button class="btn btn-sm btn-outline-danger mb-1" onclick="deleteStudent(${s.id})"> حذف</button>
                        </td>
                    </tr>
                `).join('');

            document.getElementById('pageInfo').textContent =
                `صفحه ${res.pageNumber} از ${res.totalPages} - مجموع ${res.totalCount} دانشجو`;
        }

        function renderPagination(res) {
            const ul = document.getElementById('pagination');
            ul.innerHTML = '';
            for (let p = 1; p <= res.totalPages; p++) {
                const li = document.createElement('li');
                li.className = 'page-item' + (p === res.pageNumber ? ' active' : '');
                li.innerHTML = `<a class="page-link" href="javascript:void(0)" onclick="loadStudents(${p})">${p}</a>`;
                ul.appendChild(li);
            }
        }

        // ===== افزودن =====
        function openCreateModal() {
            document.getElementById('modalTitle').textContent = 'افزودن دانشجو';
            document.getElementById('studentId').value = 0;
            document.getElementById('firstName').value = '';
            document.getElementById('lastName').value = '';
            document.getElementById('nationalCode').value = '';
            document.getElementById('phoneNumber').value = '';
            document.getElementById('dateOfBirth').value = '';
            document.getElementById('address').value = '';
            document.getElementById('status').value = '1';
            modalInstance.show();
        }

        // ===== ویرایش =====
        async function openEditModal(id) {
            try {
                const s = await ajaxGet('/Student/GetById?id=' + id);
                document.getElementById('modalTitle').textContent = 'ویرایش دانشجو';
                document.getElementById('studentId').value = s.id;
                document.getElementById('firstName').value = s.firstName || '';
                document.getElementById('lastName').value = s.lastName || '';
                document.getElementById('nationalCode').value = s.nationalCode || '';
                document.getElementById('phoneNumber').value = s.phoneNumber || '';
                document.getElementById('dateOfBirth').value = s.dateOfBirth ? s.dateOfBirth.substring(0, 10) : '';
                document.getElementById('address').value = s.address || '';
                document.getElementById('status').value = s.status.toString();
                modalInstance.show();
            } catch (e) {
                showToast('خطا در دریافت اطلاعات دانشجو', false);
            }
        }

        // ===== ذخیره (ایجاد یا ویرایش) =====
        async function saveStudent() {
            const id = parseInt(document.getElementById('studentId').value);
            const data = {
                id: id,
                firstName: document.getElementById('firstName').value.trim(),
                lastName: document.getElementById('lastName').value.trim(),
                nationalCode: document.getElementById('nationalCode').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim(),
                dateOfBirth: document.getElementById('dateOfBirth').value || null,
                address: document.getElementById('address').value.trim(),
                status: parseInt(document.getElementById('status').value)
            };

            // اعتبارسنجی سمت کلاینت
            if (!data.firstName || !data.lastName || !data.nationalCode) {
                showToast('نام، نام خانوادگی و کد ملی الزامی هستند.', false);
                return;
            }
            if (!/^\d{10}$/.test(data.nationalCode)) {
                showToast('کد ملی باید دقیقاً 10 رقم باشد.', false);
                return;
            }

            try {
                const url = id === 0 ? '/Student/Create' : '/Student/Update';
                const res = await ajaxPost(url, data);
                showToast(res.message, res.success);
                if (res.success) {
                    modalInstance.hide();
                    loadStudents(currentPage);
                }
            } catch (e) {
                showToast('خطا در ارتباط با سرور', false);
            }
        }

        // ===== حذف =====
        async function deleteStudent(id) {
            if (!confirm('آیا از حذف این دانشجو مطمئن هستید؟')) return;
            try {
                const res = await ajaxPost('/Student/Delete', { id: id });
                showToast(res.message, res.success);
                if (res.success) loadStudents(currentPage);
            } catch (e) {
                showToast('خطا در ارتباط با سرور', false);
            }
        }

        // ===== تغییر وضعیت =====
        async function toggleStatus(id) {
            try {
                const res = await ajaxPost('/Student/ToggleStatus', { id: id });
                showToast(res.message, res.success);
                if (res.success) loadStudents(currentPage);
            } catch (e) {
                showToast('خطا در ارتباط با سرور', false);
            }
        }

        // جلوگیری از XSS
        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}