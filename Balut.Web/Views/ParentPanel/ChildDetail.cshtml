@{
    ViewData["Title"] = "گزارش فرزند";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"> گزارش فرزند</h4>
    <a href="/ParentPanel/Index" class="btn btn-outline-secondary btn-sm">بازگشت</a>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><button class="nav-link active" onclick="showTab('courses', this)"> دوره‌ها</button></li>
    <li class="nav-item"><button class="nav-link" onclick="showTab('attendance', this)"> حضور و غیاب</button></li>
    <li class="nav-item"><button class="nav-link" onclick="showTab('scores', this)"> نمرات</button></li>
</ul>

<div id="tab-courses">
    <div class="card stat-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>کلاس</th><th>دوره</th><th>تاریخ ثبت‌نام</th><th>وضعیت</th></tr></thead>
                <tbody id="coursesBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="tab-attendance" style="display:none">
    <div class="card stat-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>کلاس</th><th>جلسه</th><th>تاریخ</th><th>وضعیت</th></tr></thead>
                <tbody id="attendanceBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="tab-scores" style="display:none">
    <div class="card stat-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>کلاس</th><th>جلسه</th><th>نمره</th><th>توضیح</th></tr></thead>
                <tbody id="scoresBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const studentId = @ViewData["StudentId"];

        document.addEventListener('DOMContentLoaded', () => {
            loadCourses();
            loadAttendance();
            loadScores();
        });

        function showTab(name, btn) {
            ['courses', 'attendance', 'scores'].forEach(t => {
                document.getElementById('tab-' + t).style.display = t === name ? 'block' : 'none';
            });
            document.querySelectorAll('.nav-pills .nav-link').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        async function loadCourses() {
            const items = await ajaxGet('/ParentPanel/GetChildEnrollments?studentId=' + studentId);
            document.getElementById('coursesBody').innerHTML = items.length === 0
                ? '<tr><td colspan="4" class="text-center py-4 text-muted">ثبت‌نامی وجود ندارد.</td></tr>'
                : items.map(e => `
                        <tr>
                            <td><b>${escapeHtml(e.className)}</b></td>
                            <td>${escapeHtml(e.courseTitle)}</td>
                            <td>${new Date(e.enrollmentDate).toLocaleDateString('fa-IR')}</td>
                            <td>${e.status === 1 ? '<span class="badge bg-success">فعال</span>' : '<span class="badge bg-secondary">انصراف</span>'}</td>
                        </tr>`).join('');
        }

        async function loadAttendance() {
            const items = await ajaxGet('/ParentPanel/GetChildAttendance?studentId=' + studentId);
            document.getElementById('attendanceBody').innerHTML = items.length === 0
                ? '<tr><td colspan="4" class="text-center py-4 text-muted">رکوردی ثبت نشده است.</td></tr>'
                : items.map(a => {
                    let badge = a.status === 1 ? '<span class="badge bg-success">حاضر</span>'
                        : a.status === 2 ? '<span class="badge bg-danger">غایب</span>'
                            : `<span class="badge bg-warning">تأخیر ${a.lateMinutes || 0} دقیقه</span>`;
                    return `
                        <tr>
                            <td>${escapeHtml(a.className)}</td>
                            <td>جلسه ${a.sessionNumber}</td>
                            <td>${new Date(a.date).toLocaleDateString('fa-IR')}</td>
                            <td>${badge}</td>
                        </tr>`;
                }).join('');
        }

        async function loadScores() {
            const items = await ajaxGet('/ParentPanel/GetChildScores?studentId=' + studentId);
            document.getElementById('scoresBody').innerHTML = items.length === 0
                ? '<tr><td colspan="4" class="text-center py-4 text-muted">نمره‌ای ثبت نشده است.</td></tr>'
                : items.map(s => `
                        <tr>
                            <td>${escapeHtml(s.className)}</td>
                            <td>جلسه ${s.sessionNumber}</td>
                            <td><b class="${s.scoreValue >= 5 ? 'text-success' : 'text-danger'}">${s.scoreValue} / 10</b></td>
                            <td>${escapeHtml(s.comments) || '-'}</td>
                        </tr>`).join('');
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>
}